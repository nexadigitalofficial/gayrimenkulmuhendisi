<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030712">

    <!-- Swipe Refresh + WebView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#030712" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Top Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressTint="#d4af37"
        android:visibility="gone" />

    <!-- Error / Connection Recovery Overlay -->
    <LinearLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#030712"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXA CRM PRO"
                android:textColor="#d4af37"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Coldwell Banker CB VIP"
                android:textColor="#94a3b8"
                android:textSize="12sp" />

            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#1e293b" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunucuya Bağlanılamadı"
                android:textColor="#f87171"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCurrentUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="http://192.168.1.36:5000/crm"
                android:textColor="#cbd5e1"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Telefonunuzun bilgisayarınız ile aynı Wi-Fi ağına bağlı olduğundan ve NEXA sunucusunun (port 5000) çalıştığından emin olun."
                android:textColor="#64748b"
                android:textSize="12sp" />

            <!-- Action Buttons -->
            <Button
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_gold"
                android:text="Yeniden Dene"
                android:textAllCaps="false"
                android:textColor="#030712"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnChangeServer"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Sunucu Adresini Değiştir"
                android:textAllCaps="false"
                android:textColor="#f8fafc" />

            <Button
                android:id="@+id/btnOpenDemo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Demo Modunda Aç"
                android:textAllCaps="false"
                android:textColor="#38bdf8" />

        </LinearLayout>
    </LinearLayout>

    <!-- Discreet Floating Server Settings Button (bottom right) -->
    <FrameLayout
        android:id="@+id/btnFloatingConfig"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:alpha="0.35"
        android:background="@drawable/bg_button_secondary">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="⚙"
            android:textColor="#ffffff"
            android:textSize="18sp" />
    </FrameLayout>

</FrameLayout>
