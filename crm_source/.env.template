# ================================================================
# NEXA CRM Pro — Environment Variables (.env)
# ================================================================
# Bu dosyayı proje root'unda oluştur ve değerleri doldur
# 
# UYARI: 
# - Bu dosyayı git'e commit ETME (.gitignore'a ekle)
# - Sensitive bilgileri içerir (API keys, tokens, vb.)
# ================================================================

# ── SUNUCU AYARLARI ─────────────────────────────────────────────
PORT=5000
FLASK_ENV=production
DEBUG=False

# ── FIREBASE ────────────────────────────────────────────────────
# Seçenek 1: Lokal JSON dosya yolu
FIREBASE_SERVICE_ACCOUNT=service-account.json

# Seçenek 2: Render/Cloud diziliyse JSON string olarak
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── GEMINI API ──────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── EMAIL (SMTP) ────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM=yigitnarinofficial@gmail.com
EMAIL_FROM_NAME=Nexa CRM
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=yigitnarinofficial@gmail.com
SMTP_PASSWORD=your_app_password_here

# App Password oluştur: https://myaccount.google.com/apppasswords
# (2FA açık olmalı)

# ── EMAIL OTOMASYONU ────────────────────────────────────────────
ENABLE_CUSTOMER_EMAIL_AUTOMATION=true
ADVISOR_EMAIL=advisor@example.com

# ── WHATSAPP (META CLOUD API) ───────────────────────────────────
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_system_user_token
WA_VERIFY_TOKEN=nexa_webhook_secret_key
WA_ADVISOR_PHONE=905324514008

# WhatsApp Template Names
CUSTOMER_WA_TEMPLATE_NAME=lead_received
VALUATION_WA_TEMPLATE_NAME=valuation_report

# Enable WhatsApp automation
ENABLE_CUSTOMER_WA_AUTOMATION=false

# ── TELEGRAM BOT ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── COLDWELL BANKER KONFİGURASYONU ──────────────────────────────
# Eğer CB'nin API'siyle entegrasyon yapılıyorsa
CB_OFFICE_ID=372
CB_OFFICE_USER_ID=18631

# ── CORS AYARLARI ───────────────────────────────────────────────
ALLOWED_ORIGINS=https://nexacrm.com,https://nexa-crm.onrender.com,http://localhost:5000

# ── VERİTABANI (İleride) ────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost/nexa_crm

# ── LOGGING ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=nexa-crm.log

# ── ÖZELLEŞTİRME ───────────────────────────────────────────────
# Sahibinden API (kullanılmadığında boş bırak)
SAHIBINDEN_API_KEY=

# Hepsiemlak API
HEPSIEMLAK_API_KEY=

# Emlakjet API
EMLAKJET_API_KEY=

# ================================================================
# KURULUM REHBERI:
# ================================================================
#
# 1. Lokal Geliştirme (Local):
#    FIREBASE_SERVICE_ACCOUNT=service-account.json dosya yolunu koy
#    GEMINI_API_KEY=your_key
#
# 2. Render/Vercel (Cloud):
#    Environment Variables panelinden tüm değerleri ekle
#    FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...} JSON string olarak
#
# 3. Kurulumu Doğrula:
#    python3 -c "from dotenv import load_dotenv; import os; load_dotenv(); print(os.environ.get('FIREBASE_SERVICE_ACCOUNT', 'EKSIK'))"
#
# 4. Secret Bilgi Oluşturma:
#    
#    a) Gemini API Key:
#       - https://aistudio.google.com/apikey
#       - "Create API Key" → "Create key in new Google Cloud project"
#    
#    b) Firebase:
#       - https://console.firebase.google.com
#       - Project Settings → Service Accounts → Generate new private key
#       - JSON dosyasını indir → service-account.json
#    
#    c) WhatsApp:
#       - https://business.facebook.com/wa/manage/
#       - Apps → Settings → Basic
#       - Phone Number ID ve Access Token'ı kopyala
#    
#    d) Email (Gmail):
#       - https://myaccount.google.com/apppasswords
#       - 2FA açık olmalı
#       - App Password oluştur
#    
#    e) Telegram Bot:
#       - @BotFather ile sohbet et
#       - /newbot → token al
# ================================================================
