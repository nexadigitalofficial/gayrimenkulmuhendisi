# ================================================================
# NEXA CRM PRO - ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ── FLASK ─────────────────────────────────────────────────────────
FLASK_ENV=production
PORT=5000
DEBUG=false

# ── FIREBASE ──────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=service-account.json

# ── GEMINI API ────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── WHATSAPP CLOUD API (Meta) ─────────────────────────────────────
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_permanent_access_token
WA_VERIFY_TOKEN=your_webhook_verification_token
WA_ADVISOR_PHONE=905XXXXXXXXX

# Optional: WhatsApp Templates
CUSTOMER_WA_TEMPLATE_NAME=lead_received
VALUATION_WA_TEMPLATE_NAME=valuation_report
ENABLE_CUSTOMER_WA_AUTOMATION=false

# ── EMAIL (SMTP) ──────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Nexa CRM
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_not_gmail_password

# Optional: Custom SMTP
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxx

# ── EMAIL AUTOMATION ──────────────────────────────────────────────
ENABLE_CUSTOMER_EMAIL_AUTOMATION=true
ADVISOR_EMAIL=advisor@yourcompany.com

# ── TELEGRAM (Optional) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── DATABASE ──────────────────────────────────────────────────────
# Firebase is primary, optional Redis for caching
# REDIS_URL=redis://localhost:6379/0

# ── API RATE LIMITING ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200 per hour
RATE_LIMIT_API=1000 per hour

# ── AI CONFIGURATION ─────────────────────────────────────────────
AI_MODEL=gemini-1.5-pro
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# ── LISTING SCRAPING ─────────────────────────────────────────────
SCRAPE_TIMEOUT=30
SCRAPE_RETRIES=3
SCRAPE_BROWSER=headless_chrome

# ── DEPLOYMENT ───────────────────────────────────────────────────
DEPLOYMENT_ENV=production
SERVER_URL=https://nexacrm.com
CORS_ORIGINS=https://nexacrm.com,https://app.nexacrm.com,http://localhost:3000

# ── LOGGING ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=app.log

# ── FEATURE FLAGS ────────────────────────────────────────────────
FEATURE_AI_ANALYSIS=true
FEATURE_BUYER_ENGINE=true
FEATURE_FSBO_ANALYSIS=true
FEATURE_VALUATION_REPORTS=true

# ================================================================
# INSTRUCTIONS:
# 1. Rename this file: mv .env.example .env
# 2. Fill in your actual credentials
# 3. Never commit .env to git
# 4. Add .env to .gitignore
# ================================================================
